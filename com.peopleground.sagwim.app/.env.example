# API 기본 URL — 환경별 옵션:
# 시뮬레이터: http://localhost:8080/api/v1
# 실기기(LAN): http://192.168.x.x:8080/api/v1  ← ifconfig | grep "inet " 로 Mac LAN IP 확인 후 교체
# 실기기(ngrok): https://xxxx.ngrok-free.app/api/v1
# 운영: https://sagwim.com/api/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# 소셜 로그인 브릿지 콜백 URL — 백엔드 GET /auth/social/callback
#
# 앱의 최종 도착지는 커스텀 스킴(sagwim://oauth)이지만, 구글은 web 클라이언트의
# redirect URI 에 https 를 요구하고 raw IP 를 금지한다(localhost 만 예외).
# 그래서 provider 에는 이 https(또는 localhost) 브릿지 URL 을 등록하고,
# 백엔드가 302 로 sagwim://oauth?code=... 를 되돌려주는 방식을 쓴다.
#
# 이 값은 provider 콘솔에 등록한 Redirect URI 와 "문자 단위로" 동일해야 한다.
# 다르면 카카오 KOE006 / 구글 redirect_uri_mismatch 로 실패한다.
#   시뮬레이터: http://localhost:8080/api/v1/auth/social/callback
#   실기기/운영: https://sagwim.com/api/v1/auth/social/callback
# 브릿지는 stateless 라 API 호스트와 달라도 무방하다.
EXPO_PUBLIC_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/auth/social/callback

# 카카오 OAuth — REST API 키 (Kakao Developers 콘솔 > 앱 설정 > 앱 키)
# 웹과 동일한 키를 공용으로 쓴다. 콘솔 > 카카오 로그인 > Redirect URI 에
# 위 EXPO_PUBLIC_OAUTH_REDIRECT_URI 값을 추가해야 한다.
EXPO_PUBLIC_KAKAO_CLIENT_ID=

# 구글 OAuth — 웹 클라이언트 ID (Google Cloud Console > API 및 서비스 > 사용자 인증 정보)
#
# iOS 클라이언트가 아니라 웹 클라이언트를 쓴다. iOS 클라이언트는 client_secret 이 없는데
# 백엔드 GoogleOAuthClient 는 secret 으로 code 를 교환하기 때문이다.
#
# ⚠️ 백엔드가 쓰는 클라이언트와 반드시 같아야 한다. 다르면 invalid_client 로 100% 실패한다.
#   dev  : .env.dev 의 GOOGLE_CLIENT_ID  (docker exec sagwim-dev-backend printenv GOOGLE_CLIENT_ID)
#   운영 : 루트 .env 의 GOOGLE_CLIENT_ID
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
